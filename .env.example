# Template only: this file is never discovered automatically.
# Export values in the parent process, or copy this to a protected file and
# select it explicitly with `moneybird-mcp --env-file C:\absolute\operator.env`.
# Personal token (simplest, single user):
MONEYBIRD_ACCESS_TOKEN=
# Leave blank if the token sees only one administration.
MONEYBIRD_ADMINISTRATION_ID=

MCP_HOST=127.0.0.1
MCP_PORT=8000
# Safe local default: the installed `moneybird-mcp` command uses stdio.
MCP_TRANSPORT=stdio
MONEYBIRD_CREDENTIAL_MODE=local
# Server-side mutation policy. Default is read_only when omitted. Enabling writes
# is an explicit opt-in and does not by itself prove independent human confirmation.
MONEYBIRD_CAPABILITY_MODE=read_only

# Network transports require a shared edge secret even on loopback. To run one,
# change MCP_TRANSPORT to "http" (preferred) or "sse", set credential mode to
# "network_single_user", and set a long random MCP_AUTH_TOKEN. A non-loopback bind
# is additionally refused unless TLS really terminates at a trusted proxy and
# MCP_TRUSTED_TLS_PROXY=true.
MCP_AUTH_TOKEN=
MCP_TRUSTED_TLS_PROXY=false
# Where server state lives (approvals DB, audit logs, sync caches, OAuth tokens).
# The installed console script defaults to ~/.moneybird-mcp; the legacy clone
# entrypoint uses the working directory. Set an absolute path explicitly when needed.
MONEYBIRD_MCP_DATA_DIR=
# "search" (default: compact on-demand Tool Search) or "full" for legacy clients
# that require every tool schema up front.
MCP_TOOL_DISCOVERY=search

# OAuth, for development or a self-hoster who registers their OWN external
# application. Not the default public setup: a Client Secret authenticates the
# application rather than the user, so this project ships none, and there is no
# shared credential to fill in here. Register at
# https://moneybird.com/user/applications/new with redirect URI
# urn:ietf:wg:oauth:2.0:oob, fill in your own values, then run once:
#   moneybird-mcp auth login --env-file /absolute/path/to/this/file
# These are application credentials, not your tokens. The access and refresh
# tokens are obtained by that command and stored in MONEYBIRD_MCP_DATA_DIR
# (moneybird_oauth_tokens.json) — never paste them into this file.
# Treat the client secret like a password. Placeholders only in any shared copy.
MONEYBIRD_OAUTH_CLIENT_ID=
MONEYBIRD_OAUTH_CLIENT_SECRET=
# Optional. Scope profile ("full" (default), "bookkeeping", "invoicing") or an
# explicit space-separated list. `moneybird-mcp auth scopes` explains each one.
MONEYBIRD_OAUTH_SCOPES=
